VITE_CONTRACT_ADDRESS=0xfF53f36e409FBC2d42b15e214801656006A7A226

# Same-origin RPC path. The app's own host proxies it to Studio
# (vite.config.ts in development, vercel.json in production).
VITE_STUDIO_RPC=/api/rpc

# Absolute Studio URL, used only when registering the network in MetaMask.
VITE_STUDIO_WALLET_RPC=https://studio.genlayer.com/api
